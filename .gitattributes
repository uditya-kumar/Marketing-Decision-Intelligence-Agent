# Normalise line endings to LF in the repo and working tree (matches Prettier's
# and Ruff's defaults; avoids CRLF churn on Windows checkouts).
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.pen binary
