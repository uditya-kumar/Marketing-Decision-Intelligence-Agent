# Copy to backend/.env and fill in. Never commit .env.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Database: Neon Postgres branches ---
# Use the pooled or direct connection string from the Neon console.
# DATABASE_URL points at the branch you develop against (dev).
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
# Integration tests run against the 'test' branch:
DATABASE_URL_TEST=postgresql://<user>:<password>@<test-host>/<db>?sslmode=require

# --- LLM provider (Phase 8+; only agents/llm/factory.py reads these) ---
LLM_PROVIDER=bedrock_converse          # later: google_genai
LLM_MODEL=                             # e.g. a Bedrock model id; later gemini-2.5-flash
LLM_TEMPERATURE=0
AWS_REGION=us-east-1
GOOGLE_API_KEY=
